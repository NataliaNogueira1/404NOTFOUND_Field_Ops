# Server
SERVER_PORT=8080

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fieldops
DB_USER=fieldops
DB_PASSWORD=fieldops

# Security (JWT) — at least 32 bytes (256 bits) for HS256
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-bytes
JWT_EXPIRATION=8h

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8081,http://localhost:5173

# Evidence storage directory
EVIDENCE_STORAGE_DIR=./evidences

# First-run admin bootstrap (optional, idempotent). Leave blank to skip.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
